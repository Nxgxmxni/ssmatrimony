# Root Environment Variables Configuration Example
# Copy to backend/.env and frontend/.env respectively

# Backend Environment (.env in /backend)
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ssmatrimony?retryWrites=true&w=majority
# Fallback local URI if Atlas is not configured: mongodb://127.0.0.1:27017/ssmatrimony
JWT_SECRET=ss_matrimony_super_secret_jwt_key_2026
NODE_ENV=development

# Frontend Environment (.env in /frontend)
VITE_API_BASE_URL=http://localhost:5000/api
